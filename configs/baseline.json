{
  "seed": 42,
  "thread_limit": 1,
  "tfidf": {
    "lowercase": true,
    "strip_accents": null,
    "stop_words": null,
    "min_df": 2,
    "max_df": 1.0,
    "max_features": 80000,
    "sublinear_tf": true,
    "norm": "l2",
    "token_pattern": "(?u)\\b\\w\\w+\\b"
  },
  "svm": {
    "dual": false,
    "max_iter": 5000,
    "tol": 0.0001
  },
  "search": {
    "C": [0.1, 1.0, 10.0],
    "ngram_range": [[1, 1], [1, 2]],
    "class_weight": [null, "balanced"]
  },
  "inference": {
    "batch_size": 256,
    "repeats": 3,
    "warmup_batches": 1
  }
}
